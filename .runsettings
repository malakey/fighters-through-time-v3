<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <MaxCpuCount>1</MaxCpuCount>
    <ResultsDirectory>./TestResults</ResultsDirectory>
    <TestSessionTimeout>300000</TestSessionTimeout>
    <TreatNoTestsAsError>true</TreatNoTestsAsError>
  </RunConfiguration>
  <GdUnit4>
    <!--
      The verbose engine flag is deliberately absent. It made Godot print a
      "Loading resource:" line for every load (~2,100 lines a run) straight into
      GdUnit4's WindowsStdOutHook pipe-reader thread, which races the
      Console.SetOut that hook performs at test boundaries. The reader thread then
      throws ArgumentNullException inside System.Console.Write, and an unhandled
      exception on a background thread kills the Godot child:
      "GodotRuntimeTestRunner ends with exit code: 532462766-negative"
      (0xE0434352) plus a large partial Total. Errors and warnings are still
      logged without it. Re-add it locally, never on main, for a load trace.
    -->
    <Parameters>--headless</Parameters>
    <DisplayName>FullyQualifiedName</DisplayName>
    <CaptureStdOut>true</CaptureStdOut>
    <CompileProcessTimeout>120000</CompileProcessTimeout>
    <GodotConnectTimeout>60000</GodotConnectTimeout>
  </GdUnit4>
</RunSettings>
