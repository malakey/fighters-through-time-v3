[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/UI/LoadingScreen.cs" id="1_script"]
[ext_resource type="Theme" path="res://resources/UI/ftt_theme.tres" id="2_theme"]
; Plain loading variant (TG-SCREENS, UI_SPEC_GLASS 9.2): the bg0 field, the screen streak, the 64 px hourglass in
; accent2 centred with its glow breathing at 0.5 Hz (static under Reduced Temporal Effects) and the status caption.
; The hourglass, its glow and the streak are added by LoadingScreen.cs into HourglassHost and Root.

[node name="LoadingScreen" type="CanvasLayer"]
layer = 100
process_mode = 3
script = ExtResource("1_script")

[node name="Root" type="Control" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
theme = ExtResource("2_theme")

[node name="Background" type="ColorRect" parent="Root"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.0196, 0.0275, 0.102, 1)

[node name="Center" type="CenterContainer" parent="Root"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Stack" type="VBoxContainer" parent="Root/Center"]
layout_mode = 2
theme_override_constants/separation = 22

[node name="HourglassHost" type="Control" parent="Root/Center/Stack"]
custom_minimum_size = Vector2(64, 64)
layout_mode = 2
size_flags_horizontal = 4
mouse_filter = 2

[node name="StatusLabel" type="Label" parent="Root/Center/Stack"]
layout_mode = 2
theme_type_variation = &"SceneCaption"
text = "loading"
horizontal_alignment = 1
uppercase = true
