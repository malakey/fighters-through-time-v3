[gd_scene load_steps=7 format=3]

; Package 8 B2 - the production Fighter Mode HUD, rebuilt by UR-HUDF (pulp UI
; redesign, HUD-F2 "top versus bars", UI_SPEC 4.5).
;
; Attached by FighterSimulationDriver for every stage rather than authored into
; each stage scene. Both clusters hang from the TOP corners (margin 36 / 22), the
; match timer plate hangs from the top centre, and a slot row per player (three
; 54 px ability slots plus the two status chips) hangs below each cluster. Those
; widgets (portrait roundel, slot shape, stock stars, shield pips, Defy icon,
; slots, chips) are built by FighterHUD.cs because they are Pulp widgets and the
; stock / shield counts are data-driven.
;
; The old Label glyph nodes (SlotBadge, the Damage / Control status indicators,
; DefySeal, the three cooldown icons with their Radial) are kept under their old
; paths as accessibility and test carriers, hidden: tests and tooltips read their
; Text, and shape now rides the icons. P2 HP and meter fill from the outer edge
; (fill_mode = 1), as P1 does.

[ext_resource type="Script" path="res://scripts/UI/FighterHUD.cs" id="1_hud"]
[ext_resource type="Theme" path="res://resources/UI/ftt_theme.tres" id="2_theme"]
[ext_resource type="Script" path="res://scripts/UI/RadialProgress.cs" id="3_radial"]

