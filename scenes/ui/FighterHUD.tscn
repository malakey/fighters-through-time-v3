[gd_scene load_steps=4 format=3]

; Package 8 B2 - the production Fighter Mode HUD.
;
; Attached by FighterSimulationDriver for every stage rather than authored into
; each stage scene, so the ten production stages and the Test Arena share one
; surface. The stock / shield pips are built by the script because their counts
; are data-driven (match stock rules, per-character MaxBlockCharges); everything
; with a fixed shape is authored here - including, since Package 12 W5 (M25),
; the four 20x20 radial cooldowns (S1 / S2 / Movement / Echo Step) beside the
; block charges (P2 mirrored), and (G12) the P1 triangle / P2 circle slot badge
; beside each name tag.
;
; M-29 (audit 2026-08-08): both player clusters anchor to the BOTTOM of the
; screen per design :2617 ("Bottom of screen, evenly spaced (P1 left, P2
; right)"); the match clock stays top-center. HP bars keep depleting toward the
; center (P2 fill_mode = 1).

[ext_resource type="Script" path="res://scripts/UI/FighterHUD.cs" id="1_hud"]
[ext_resource type="Theme" path="res://resources/UI/ftt_theme.tres" id="2_theme"]
[ext_resource type="Script" path="res://scripts/UI/RadialProgress.cs" id="3_radial"]

[node name="FighterHUD" type="CanvasLayer"]
layer = 12
script = ExtResource("1_hud")

[node name="SafeArea" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = ExtResource("2_theme")

