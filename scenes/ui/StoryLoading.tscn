[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/UI/LoadingScreen.cs" id="1_script"]
[ext_resource type="Theme" path="res://resources/UI/ftt_theme.tres" id="2_theme"]

; Story portal variant. The "rift" is placeholder geometry - a cyan-cored slit
; over the deep navy field - standing in for the Chronal Rift treatment that
; lands with production art. TitleLabel is filled by LoadingScreen.Configure
; from the destination campaign scene path.

