text = "loading_rift"
horizontal_alignment = 1
uppercase = true

[node name="StatusLabel" type="Label" parent="Root/Center/Stack"]
visible = false
layout_mode = 2
theme_type_variation = &"SceneCaption"
text = "loading"
horizontal_alignment = 1
uppercase = true
