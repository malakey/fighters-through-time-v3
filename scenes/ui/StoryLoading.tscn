[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/UI/LoadingScreen.cs" id="1_script"]
[ext_resource type="Theme" path="res://resources/UI/ftt_theme.tres" id="2_theme"]
; Story portal variant (TG-SCREENS, UI_SPEC_GLASS 9.2): the bg0 field and the screen streak; the destination's title in
; T03 between flourishes, centred around y 470 (TitleLabel, filled by LoadingScreen.Configure from the destination
; campaign scene path; the flourishes are added around it in code); under it loading_rift in T51 (MenuTagline). The
; status line is kept for the variant contract but not shown: the rift line already says what is happening.

[node name="StoryLoading" type="CanvasLayer"]
layer = 100
process_mode = 3
script = ExtResource("1_script")

[node name="Root" type="Control" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
theme = ExtResource("2_theme")

[node name="Background" type="ColorRect" parent="Root"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.0196, 0.0275, 0.102, 1)

[node name="Center" type="CenterContainer" parent="Root"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_bottom = -100.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Stack" type="VBoxContainer" parent="Root/Center"]
layout_mode = 2
theme_override_constants/separation = 22

[node name="TitleLabel" type="Label" parent="Root/Center/Stack"]
custom_minimum_size = Vector2(1500, 0)
layout_mode = 2
theme_type_variation = &"BannerHeading"
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 3
uppercase = true

[node name="RiftLabel" type="Label" parent="Root/Center/Stack"]
layout_mode = 2
