[gd_scene load_steps=3 format=3]

; Package 12 W5 (H05/G01, adopted D4(a)) - the Fighter Mode Play Options menu.
; The main menu's Fighter button opens this: Local Versus (two-human select) or
; Versus CPU (P1-only select -> CPU configuration panel -> match). Steam Remote
; Play Together stays a notice (DEFER-STEAM-RPT). Raw translation keys in text.
; TG-SCREENS (UI_SPEC_GLASS 9.2): a full-screen menu. The sub-screen art, the heading fighter_play_options_title between
; flourishes top-centre, a centred glass slab holding the chevron column and the notice, the prompt bar bottom-right and
; the screen streak (the art, heading, decor and streak are added by FighterPlayOptionsScreen.cs).

[ext_resource type="Script" path="res://scripts/UI/FighterPlayOptionsScreen.cs" id="1_script"]
[ext_resource type="Theme" path="res://resources/UI/ftt_theme.tres" id="2_theme"]

[node name="FighterPlayOptions" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_script")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.0196, 0.0275, 0.102, 1)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(680, 0)
layout_mode = 2

[node name="Layout" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 11

[node name="LocalVersusButton" type="Button" parent="Center/Panel/Layout"]
custom_minimum_size = Vector2(0, 68)
layout_mode = 2
theme_type_variation = &"PulpButton"
text = "fighter_play_local_versus"

[node name="VersusCpuButton" type="Button" parent="Center/Panel/Layout"]
custom_minimum_size = Vector2(0, 68)
layout_mode = 2
theme_type_variation = &"PulpButton"
text = "fighter_play_versus_cpu"

[node name="RemotePlayNotice" type="Label" parent="Center/Panel/Layout"]
custom_minimum_size = Vector2(560, 0)
layout_mode = 2
focus_mode = 2
theme_type_variation = &"BodyCompactLabel"
text = "fighter_remote_play_notice"
horizontal_alignment = 1
autowrap_mode = 3

[node name="BackButton" type="Button" parent="Center/Panel/Layout"]
custom_minimum_size = Vector2(0, 68)
layout_mode = 2
theme_type_variation = &"PulpButton"
text = "common_back"
