[gd_scene load_steps=4 format=3]

; Package 12 W5 (H05/G01, adopted D4(a)) - the Fighter Mode Play Options menu.
; The main menu's Fighter button opens this: Local Versus (two-human select) or
; Versus CPU (P1-only select -> CPU configuration panel -> match). Steam Remote
; Play Together stays a notice (DEFER-STEAM-RPT). Raw translation keys in text.

[ext_resource type="Script" path="res://scripts/UI/FighterPlayOptionsScreen.cs" id="1_script"]
[ext_resource type="Theme" path="res://resources/UI/ftt_theme.tres" id="2_theme"]
[ext_resource type="Texture2D" path="res://assets/backgrounds/menu/temporal_glass_fighter_select_background.png" id="3_art"]

