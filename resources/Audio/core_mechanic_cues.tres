[gd_resource type="Resource" script_class="CoreMechanicCueCatalog" load_steps=42 format=3]

; H04 (design-godot.md Section 8 "7. Core Mechanic Cues"; Package 12 W10).
; The single canonical core-mechanic cue catalog. Every stream is a SILENT
; placeholder (2026-08-10 directive); Package 10 replaces them by reassignment.
; Critical = true rows always route through AudioManager.PlayCriticalCue.
; The ten stage-hazard warning/impact pairs live on each StageAudioSet.

[ext_resource type="Script" path="res://scripts/Core/CoreMechanicCueCatalog.cs" id="1_catalog"]
[ext_resource type="Script" path="res://scripts/Core/CoreMechanicCueEntry.cs" id="2_entry"]
[ext_resource type="AudioStream" path="res://audio/sfx/chronal/rewind_sweep.ogg" id="3_sweep"]
[ext_resource type="AudioStream" path="res://audio/sfx/chronal/clock_tick.ogg" id="4_tick"]
[ext_resource type="AudioStream" path="res://resources/Audio/placeholder_sfx_hit.tres" id="5_hit"]
[ext_resource type="AudioStream" path="res://resources/Audio/placeholder_sfx_footstep.tres" id="6_footstep"]
[ext_resource type="AudioStream" path="res://resources/Audio/placeholder_sfx_pickup.tres" id="7_pickup"]
[ext_resource type="AudioStream" path="res://resources/Audio/placeholder_sfx_ui.tres" id="8_ui"]
[ext_resource type="AudioStream" path="res://audio/sfx/ui/countdown_blip.ogg" id="9_blip"]
[ext_resource type="AudioStream" path="res://audio/sfx/combat/ko_stinger.ogg" id="10_ko"]
[ext_resource type="AudioStream" path="res://audio/sfx/ui/victory_fanfare.ogg" id="11_fanfare"]
[ext_resource type="AudioStream" path="res://resources/Audio/placeholder_sfx_hazard.tres" id="12_hazard"]

[sub_resource type="Resource" id="time_freeze_activate"]
script = ExtResource("2_entry")
CueID = "time_freeze_activate"
Bus = "SFX"
Critical = true
Stream = ExtResource("3_sweep")
DesignNote = "Sharp glassy inhale ending in a clock-stop clunk."

[sub_resource type="Resource" id="time_freeze_drone"]
script = ExtResource("2_entry")
CueID = "time_freeze_drone"
Bus = "SFX"
Critical = true
Stream = ExtResource("3_sweep")
DesignNote = "Subdued time-stop drone under stopped scene action; the hero's own movement stays audible."

[sub_resource type="Resource" id="time_freeze_thaw_warning"]
script = ExtResource("2_entry")
CueID = "time_freeze_thaw_warning"
Bus = "SFX"
Critical = true
Stream = ExtResource("4_tick")
DesignNote = "Three accelerating ticks over the final 0.5 s."

[sub_resource type="Resource" id="time_freeze_thaw_release"]
script = ExtResource("2_entry")
CueID = "time_freeze_thaw_release"
Bus = "SFX"
Critical = true
Stream = ExtResource("3_sweep")
DesignNote = "Reverse-cymbal swell as the world resumes."

[sub_resource type="Resource" id="post_landing_thaw_warning"]
script = ExtResource("2_entry")
CueID = "post_landing_thaw_warning"
Bus = "SFX"
Critical = true
Stream = ExtResource("4_tick")
DesignNote = "R03: reuses the Time Freeze thaw warning at the end of the 60-frame Post-Landing Hold."

