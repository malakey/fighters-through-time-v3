[gd_resource type="Resource" script_class="CoreMechanicCueCatalog" load_steps=51 format=3]

; H04 (design-godot.md Section 8 "7. Core Mechanic Cues"; Package 12 W10).
; The single canonical core-mechanic cue catalog. Every stream is a SILENT
; placeholder (2026-08-10 directive) except the audible combat placeholders
; (GR-AUDIO, 2026-11-03: hit_basic, block, perfect_block, swing_whiff, grab_catch,
; ko_stinger and its decisive variant, defy_burst, ultimate_activation_windup), which play at VolumeDb -12 and
; can be muted apart from SFX. Package 10 replaces every stream by reassignment.
; Critical = true rows always route through AudioManager.PlayCriticalCue.
; The ten stage-hazard warning/impact pairs live on each StageAudioSet.

